{
  "name": "@webpqc/mldsa",
  "version": "0.1.0",
  "exports": "./mod.ts",
  "publish": {
    "exclude": [
      "dnt.ts",
      "bench/",
      "coverage/",
      "test/",
      "tsconfig.json",
      "CHANGES.md"
    ]
  },
  "tasks": {
    "test": "deno test ./test --fail-fast --doc --coverage=coverage --parallel --allow-read",
    "cov": "deno coverage ./coverage --lcov --exclude='test'",
    "dnt": "deno task dnt:webpqc-mldsa",
    "dnt:webpqc-mldsa": "deno run -A dnt.ts @webpqc/mldsa"
  }
}
